{
  "schemaVersion": 7,
  "general": {
    "startWithWindows": false,
    "showOnStartup": false,
    "hideAfterLaunch": true,
    "clearQueryOnShow": true,
    "hideOnFocusLost": true,
    "showTrayIcon": true,
    "popupMonitor": "cursor"
  },
  "hotkey": {
    "modifiers": [
      "alt"
    ],
    "key": "space",
    "auxiliary": {
      "enabled": false,
      "modifiers": [],
      "key": "pause"
    }
  },
  "hotkeys": {
    "bindings": {
      "launcher.activate": {
        "enabled": true,
        "modifiers": [
          "alt"
        ],
        "key": "space"
      },
      "launcher.activateSecondary": {
        "enabled": false,
        "modifiers": [],
        "key": "pause"
      },
      "launcher.openSettings": {
        "enabled": true,
        "modifiers": [],
        "key": "f2"
      },
      "result.navigateCurrentFileManager": {
        "enabled": true,
        "modifiers": [
          "ctrl"
        ],
        "key": "enter"
      },
      "result.copySelectedTarget": {
        "enabled": true,
        "modifiers": [
          "ctrl",
          "shift"
        ],
        "key": "c"
      }
    }
  },
  "behavior": {
    "pinyinSearch": true,
    "wildcardMatching": false,
    "numericQuickLaunch": false,
    "numericQuickLaunchOrder": "one-to-zero",
    "executeSingleResultImmediately": false
  },
  "appearance": {
    "launcher": "classic",
    "language": "zh-CN",
    "showResultIcons": false
  },
  "providers": {
    "windows.startmenu": true,
    "windows.packaged": true,
    "windows.apppaths": true,
    "windows.path": true,
    "everything.filesystem": false
  },
  "update": {
    "autoCheck": true,
    "channel": "stable"
  }
}
