{
  "schemaVersion": 4,
  "general": {
    "startWithWindows": true,
    "showOnStartup": false,
    "hideAfterLaunch": false,
    "clearQueryOnShow": true,
    "hideOnFocusLost": false,
    "showTrayIcon": true,
    "popupMonitor": "cursor"
  },
  "hotkey": {
    "modifiers": [
      "win"
    ],
    "key": "space",
    "auxiliary": {
      "enabled": false,
      "modifiers": [],
      "key": "pause"
    }
  },
  "hotkeys": {
    "bindings": {
      "launcher.activate": {
        "enabled": true,
        "modifiers": [
          "win"
        ],
        "key": "space"
      },
      "launcher.activateSecondary": {
        "enabled": false,
        "modifiers": [],
        "key": "pause"
      },
      "launcher.openSettings": {
        "enabled": true,
        "modifiers": [],
        "key": "f5"
      },
      "result.navigateCurrentFileManager": {
        "enabled": true,
        "modifiers": [
          "ctrl",
          "alt"
        ],
        "key": "enter"
      },
      "result.copySelectedTarget": {
        "enabled": true,
        "modifiers": [
          "ctrl",
          "shift"
        ],
        "key": "v"
      }
    }
  },
  "behavior": {
    "wildcardMatching": true,
    "numericQuickLaunch": false,
    "numericQuickLaunchOrder": "one-to-zero",
    "executeSingleResultImmediately": false
  },
  "appearance": {
    "launcher": "classic",
    "language": "en-US"
  },
  "providers": {
    "windows.startmenu": true,
    "windows.packaged": true,
    "windows.apppaths": false,
    "windows.path": true,
    "everything.filesystem": true
  }
}
